# Bu dosyanin adini .env yapip degerleri doldurun.

# --- LLM servisi ---
LLM_URL=https://SIRKET-LLM-ADRESI/chat/completions
LLM_APP_NAME=BURAYA_UYGULAMA_ADI
# Auth gerekiyorsa buraya yazin, yoksa bos birakin
LLM_TOKEN=
LLM_TIMEOUT=400
# PDF sayfa modunda ayni anda kac sayfa LLM'e gonderilsin
LLM_PARALEL=3
# Ortam degiskenlerindeki proxy kullanilsin mi (Bruno'da calisip burada zaman asimi varsa false deneyin)
LLM_SISTEM_PROXY=true

# --- Seslendirme (TTS) servisi ---
TTS_URL=https://SIRKET-TTS-ADRESI/speech/synthesize/cognitiveservices/v1
# Ocp-Apim-Subscription-Key degeri
TTS_KEY=
# X-Microsoft-OutputFormat degeri (Bruno'dakiyle ayni olmali)
TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
# <voice name="..."> degeri
TTS_VOICE=SES_MODELI_ADI
# <lexicon uri="..."> degeri, yoksa bos birakin
TTS_LEXICON=
TTS_LANG=tr-TR
TTS_TIMEOUT=300
# 503/429 gibi gecici hatalarda kac kez tekrar denensin
TTS_RETRY=4
# Ardisik istekler arasi bekleme (sn); 503 sik geliyorsa artirin
TTS_BEKLEME=0.3
# Ortam degiskenlerindeki proxy kullanilsin mi (Bruno'da calisip burada kopma / zaman asimi varsa false deneyin)
TTS_SISTEM_PROXY=true
# TTS proxy'si: bos = ortam degiskenleri, windows = Windows Internet Ayarlari'ndaki proxy (Bruno/tarayici gibi),
# yok = dogrudan, veya adres (http://proxy.sirket:8080). Hangisi gerektigini tts_test.py gosterir.
# Windows otomatik proxy betigi (PAC) kullaniyorsa Python onu okuyamaz: tts_test.py PAC'teki proxy'leri
# tek tek dener ve calisan adresi TTS_PROXY icin onerir.
TTS_PROXY=
# Istegin User-Agent'i. Bos: python-httpx. Aradaki gateway python isteklerini engelliyorsa (HTML 503 / 403)
# tts_test.py'nin onerdigi degeri yazin, ornek: Mozilla/5.0 (Windows NT 10.0; Win64; x64) DocVoice/1.0
TTS_USER_AGENT=

# --- Video (hepsi istege bagli) ---
# Renkler: #E30613, E30613, #FFF veya red gibi yazilabilir; bos birakilirsa varsayilan kullanilir
VIDEO_BG=#0E1A2B
VIDEO_BG2=#16304F
VIDEO_ACCENT=#2EC4B6
# Logo icin PNG/JPG dosya yolu. Tirnaksiz yazin veya / kullanin:
#   VIDEO_LOGO=C:/Users/kullanici/Documents/DocVoice/logo.png
#   VIDEO_LOGO=logo.png   (proje klasorundeyse)
VIDEO_LOGO=
# Slayt modunda logonun arkasina beyaz kutu: otomatik (koyu logoda eklenir), true veya false
VIDEO_LOGO_ZEMIN=otomatik
# Arayuzde "Altyazi goster" kutusunun varsayilan durumu
VIDEO_ALTYAZI=true
# Sag ustte sayfa numarasi gosterilsin mi
VIDEO_SAYFA_NO=false
# PDF sayfasinin bos kenarlarini kirpip tum ekrani kullan (false: sayfa tam haliyle, altyazi bandi ayri)
VIDEO_PDF_TAM_EKRAN=true
# Altyazi gorunumu: kutusuz (konturlu beyaz yazi) veya kutu (siyah kutu icinde)
VIDEO_ALTYAZI_STIL=kutusuz
# En altta ince ilerleme cizgisi
VIDEO_ILERLEME=true
# Sag alt kosede konusan 2D sunucu karakteri (arayuzdeki anahtarin varsayilani, izleyici bunu kullanir)
VIDEO_KARAKTER=false
# Karakter: sunucu (kadin sunucu), maya (maskot), foto (KARAKTER_FOTO) veya ozel (KARAKTER_KLASORU)
VIDEO_KARAKTER_TIPI=sunucu
# Karakterin boyutu (1 = tam boy, 0.8 = %80; 0.4 ile 1.2 arasi)
VIDEO_KARAKTER_BOYUT=0.8
# Kendi karakteriniz: kapali.png, yarim.png, acik.png (+ istege bagli kirpik.png) iceren klasor
KARAKTER_KLASORU=
# Fotograftan konusan karakter (yuvarlak cerceve, ayarlanirsa varsayilan karakter olur).
# Fotograf repoya konmaz; proje disinda veya karakter_foto/ klasorunde tutun. Yuz onden ve net olmali.
KARAKTER_FOTO=
# Gozler / agiz otomatik bulunamazsa (fotograf pikselleri): sol_goz_x,y;sag_goz_x,y;agiz_x,y
KARAKTER_FOTO_NOKTALAR=
# Cerceve ici zemin rengi (duz siyah/beyaz arka plan otomatik ayiklanir) veya "orijinal"
KARAKTER_FOTO_ZEMIN=#EEF2F7
# PDF modunda gosterge kartlarini modern sunum slayti olarak yeniden ciz
VIDEO_SUNUM=true

# --- Klasor izleyici (izleyici.py) ---
# Yeni PDF'lerin dusecegi klasor ve videolarin aktarilacagi klasor (tirnaksiz yazin veya / kullanin)
#   IZLE_KLASORU=C:/Users/kullanici/Documents/DocVoice/gelen
#   IZLE_KLASORU=//sunucu/paylasim/raporlar      (ag paylasimi)
IZLE_KLASORU=
IZLE_HEDEF_KLASORU=
# Klasor kac saniyede bir kontrol edilsin
IZLE_ARALIK=10
# Dosya boyutu bu kadar saniye degismezse kopyalama bitti sayilir
IZLE_BEKLEME=5
# Izleyicinin kullanacagi kural seti (bos: rules/kurallar.txt)
IZLE_KURALLAR=
# .srt altyazi dosyasini da hedef klasore koy
IZLE_SRT=true

# --- Qlik Sense: videoyu content library'ye yukleme (QRS API) ---
# Yukleme (QRS API) adresi. Sertifika ile: https://qliksunucu:4242   Header ile: virtual proxy (https://qliksunucu/proxyadi)
# Size sadece "dosyayi birakacaginiz klasor" (https://qliksunucu/content/KutuphaneAdi) verildiyse onu da yazabilirsiniz:
# kutuphane adi ve izleme adresi oradan cikarilir, yukleme adresi tahmin edilir (yan panelde gosterilir).
QLIK_URL=
# Content library adi = izleme adresindeki /content/ sonrasi kisim (https://qliksunucu/content/KutuphaneAdi)
QLIK_KUTUPHANE=
# sertifika (client.pem + client_key.pem) veya header (header ile kimlik dogrulayan virtual proxy)
QLIK_KIMLIK=sertifika
# Ornekler (tirnaksiz yazin):
#   sertifika: QLIK_KULLANICI=UserDirectory=INTERNAL; UserId=sa_repository
#              QLIK_KULLANICI=UserDirectory=SIRKETDOMAIN; UserId=servis_kullanici
#   header:    QLIK_KULLANICI=SIRKETDOMAIN\servis_kullanici   (virtual proxy ayarina gore sadece servis_kullanici)
QLIK_KULLANICI=
QLIK_HEADER_ADI=X-Qlik-User
QLIK_SERTIFIKA=C:/qlik_sertifika/client.pem
QLIK_ANAHTAR=C:/qlik_sertifika/client_key.pem
QLIK_KOK_SERTIFIKA=C:/qlik_sertifika/root.pem
QLIK_SSL_DOGRULA=true
# Videonun izlenecegi adresin koku (bos: QLIK_URL). Sertifika ile 4242'ye baglaniliyorsa hub adresini yazin:
QLIK_ICERIK_URL=
QLIK_UZERINE_YAZ=true
# Qlik'teki dosya adi hep ayni olsun (eski video uzerine yazilir, birikmez).
# Bos: kaynak PDF/Word adi, tarih oneki atilarak (20261111_APK_Rapor.pdf -> APK_Rapor.mp4)
QLIK_DOSYA_ADI=
QLIK_TARIHSIZ=true
# Qlik'e AYNI adla gonderilecek dosyalar (virgulle): video, pdf (kaynak PDF), ses (videonun sesi), srt (altyazi)
# Ornek: QLIK_DOSYA_ADI=Rapor_Ozeti + video,pdf,ses -> Rapor_Ozeti.mp4, Rapor_Ozeti.pdf, Rapor_Ozeti.mp3
QLIK_YUKLENECEKLER=video,pdf,ses
# Izleme klasorune iki PDF geliyorsa: adinda bu kalip gecen PDF videoya CEVRILMEZ, dogrudan Qlik'e yuklenir
# (tarih oneki yok sayilir; virgulle birden fazla; joker de olur: APKO_Detay*). Tanimliysa videonun kendi
# PDF'i gonderilmez, content'teki PDF bu dosya olur. Bos: her PDF videoya cevrilir.
IZLE_QLIK_PDF=
# Dogrudan yuklenen PDF'in Qlik'teki adi. Bos: QLIK_DOSYA_ADI (video ile ayni ad, ornegin Rapor_Ozeti.pdf)
QLIK_PDF_DOSYA_ADI=
# Ses dosyasi bicimi: mp3 | m4a | wav
QLIK_SES_FORMATI=mp3
# .srt altyazi dosyasini da yukle (QLIK_YUKLENECEKLER'e srt eklemekle ayni)
QLIK_SRT=false
QLIK_TIMEOUT=600
# Izleyici olusan videoyu otomatik Qlik'e yuklesin
IZLE_QLIK=false

# SSL hatasi alirsaniz once BT'den sertifika isteyin; gecici cozum olarak false yapilabilir
VERIFY_SSL=true

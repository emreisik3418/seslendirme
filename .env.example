# Bu dosyanin adini .env yapip degerleri doldurun.

# --- LLM servisi ---
LLM_URL=https://SIRKET-LLM-ADRESI/chat/completions
LLM_APP_NAME=BURAYA_UYGULAMA_ADI
# Auth gerekiyorsa buraya yazin, yoksa bos birakin
LLM_TOKEN=
LLM_TIMEOUT=400
# PDF sayfa modunda ayni anda kac sayfa LLM'e gonderilsin
LLM_PARALEL=3

# --- Seslendirme (TTS) servisi ---
TTS_URL=https://SIRKET-TTS-ADRESI/speech/synthesize/cognitiveservices/v1
# Ocp-Apim-Subscription-Key degeri
TTS_KEY=
# X-Microsoft-OutputFormat degeri (Bruno'dakiyle ayni olmali)
TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
# <voice name="..."> degeri
TTS_VOICE=SES_MODELI_ADI
# <lexicon uri="..."> degeri, yoksa bos birakin
TTS_LEXICON=
TTS_LANG=tr-TR
TTS_TIMEOUT=300
# 503/429 gibi gecici hatalarda kac kez tekrar denensin
TTS_RETRY=4
# Ardisik istekler arasi bekleme (sn); 503 sik geliyorsa artirin
TTS_BEKLEME=0.3

# --- Video (hepsi istege bagli) ---
# Renkler: #E30613, E30613, #FFF veya red gibi yazilabilir; bos birakilirsa varsayilan kullanilir
VIDEO_BG=#0E1A2B
VIDEO_BG2=#16304F
VIDEO_ACCENT=#2EC4B6
# Logo icin PNG/JPG dosya yolu. Tirnaksiz yazin veya / kullanin:
#   VIDEO_LOGO=C:/Users/kullanici/Documents/DocVoice/logo.png
#   VIDEO_LOGO=logo.png   (proje klasorundeyse)
VIDEO_LOGO=
# Slayt modunda logonun arkasina beyaz kutu: otomatik (koyu logoda eklenir), true veya false
VIDEO_LOGO_ZEMIN=otomatik
# Arayuzde "Altyazi goster" kutusunun varsayilan durumu
VIDEO_ALTYAZI=true
# Sag ustte sayfa numarasi gosterilsin mi
VIDEO_SAYFA_NO=false
# PDF modunda gosterge kartlarini modern sunum slayti olarak yeniden ciz
VIDEO_SUNUM=true

# --- Klasor izleyici (izleyici.py) ---
# Yeni PDF'lerin dusecegi klasor ve videolarin aktarilacagi klasor (tirnaksiz yazin veya / kullanin)
#   IZLE_KLASORU=C:/Users/kullanici/Documents/DocVoice/gelen
#   IZLE_KLASORU=//sunucu/paylasim/raporlar      (ag paylasimi)
IZLE_KLASORU=
IZLE_HEDEF_KLASORU=
# Klasor kac saniyede bir kontrol edilsin
IZLE_ARALIK=10
# Dosya boyutu bu kadar saniye degismezse kopyalama bitti sayilir
IZLE_BEKLEME=5
# Izleyicinin kullanacagi kural seti (bos: rules/kurallar.txt)
IZLE_KURALLAR=
# .srt altyazi dosyasini da hedef klasore koy
IZLE_SRT=true

# SSL hatasi alirsaniz once BT'den sertifika isteyin; gecici cozum olarak false yapilabilir
VERIFY_SSL=true

# Bu dosyanin adini .env yapip degerleri doldurun.

# --- LLM servisi ---
LLM_URL=https://SIRKET-LLM-ADRESI/chat/completions
LLM_APP_NAME=BURAYA_UYGULAMA_ADI
# Auth sekmesinde token varsa buraya yazin, yoksa bos birakin
LLM_TOKEN=
LLM_TIMEOUT=400

# --- TTS servisi (sonra doldurulacak) ---
TTS_URL=
TTS_APP_NAME=
TTS_TOKEN=

# SSL hatasi alirsaniz once BT'den sertifika isteyin; gecici cozum olarak false yapilabilir
VERIFY_SSL=true
